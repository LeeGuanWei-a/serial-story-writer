{
  "name": "@leeguanwei/dsh-serial-story",
  "version": "0.2.1",
  "description": "A DeepSeek Harness plugin for writing linked short-story collections inside one shared world, with character profiles shared across collections and every write gated by native approval.",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeeGuanWei-a/serial-story-writer.git"
  },
  "bugs": {
    "url": "https://github.com/LeeGuanWei-a/serial-story-writer/issues"
  },
  "homepage": "https://github.com/LeeGuanWei-a/serial-story-writer#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./agent-v2": {
      "types": "./lib/agent-v2.d.ts",
      "default": "./lib/agent-v2.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "build": "node scripts/clean-lib.mjs && tsc -p tsconfig.build.json && node scripts/build-bundle.mjs && node scripts/link-self.mjs && node scripts/verify-built.mjs",
    "bundle": "node scripts/clean-lib.mjs && tsc -p tsconfig.build.json && node scripts/build-bundle.mjs",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-brand": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-util-values": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.1-rc.2 <0.3.0-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-instructions": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "js-yaml": "4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "license": "MIT",
  "icon": "icon.svg"
}
